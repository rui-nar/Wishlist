// The app's identity (IOS_APP_PLAN D1, D3): the base configuration of the
// Runner project, so both targets and every configuration read it.
//
// The committed values are placeholders. A build for VAL or PROD writes
// Identity.local.xcconfig next to this file (not committed), whose values
// replace these.

// The bundle id. PROD's is IOS_BUNDLE_ID, VAL's IOS_BUNDLE_ID_VAL: two apps,
// so a VAL build never replaces a PROD one. The tests' target appends
// ".RunnerTests".
SHUSHGIFT_BUNDLE_ID = com.example.shushgift

// The name under the icon: "Shush Gift VAL" for VAL.
SHUSHGIFT_DISPLAY_NAME = Shush Gift

// Google's iOS client ID reversed, which Google sign-in needs as a URL scheme:
// com.googleusercontent.apps.<id> for the client <id>.apps.googleusercontent.com.
// The app gets the client ID itself from --dart-define=GOOGLE_IOS_CLIENT_ID
// (client/lib/src/config.dart); a build that sets one must set both, or
// Google's SDK stops the app at sign-in. Without them the app offers no
// Google sign-in, and this placeholder registers a scheme nothing uses.
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.unset

PRODUCT_BUNDLE_IDENTIFIER = $(SHUSHGIFT_BUNDLE_ID)

// The host whose links open the app (SHUSH_GIFT_PLAN D7): the host of the
// build's API_BASE_URL_* secret, set by ios-release.yml. None here.
SHUSHGIFT_APP_LINK_HOST =

// The app's entitlements: Sign in with Apple only, unless a build with an
// app-link host replaces this with Runner/RunnerAppLinks.entitlements, which
// adds the Associated Domains entitlement applinks:$(SHUSHGIFT_APP_LINK_HOST).
// An entitlements file cannot leave a key out by itself, hence two files.
// The Runner target does not set it, so this value applies; the tests'
// target sets it empty, as it signs with none.
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements

#include? "Identity.local.xcconfig"
