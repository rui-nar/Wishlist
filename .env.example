# Wishlist — local DEV environment variables.
#
# Copy this file to `.env` (gitignored, never committed) and adjust if needed;
# the defaults below work as they are on the dev machine. `dev.ps1` loads it
# into the environment before starting anything, and docker-compose.dev.yml
# passes it to the Postgres container with `env_file:`.
#
# The server reads its settings from environment variables only (plan D10):
# server/app/settings.py never reads this file itself. VAL and PROD have their
# own .env on the VPS, with their own values.

# ── Postgres container (docker-compose.dev.yml) ──────────────────────────────

# Used by the official Postgres image on FIRST BOOT only, when the volume is
# empty: it creates this user (a superuser, so it may CREATE DATABASE, which
# the migration test needs) and this database. Changing them later does not
# alter an existing volume: run `.\dev.ps1 -Reset` to start over.
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=wishlist
POSTGRES_DB=wishlist

# ── Server settings (server/app/settings.py) ─────────────────────────────────

# SQLAlchemy URL with the psycopg 3 driver. Must match the POSTGRES_* values
# above. Postgres is published on 127.0.0.1:5432 only, so the host is
# 127.0.0.1, not localhost: Windows resolves localhost to ::1 first, and every
# connection would wait for the 5 s connect timeout before falling back.
DATABASE_URL=postgresql+psycopg://wishlist:wishlist@127.0.0.1:5432/wishlist

# dev, validation or production.
APP_ENV=dev

# Shown by /api/version and the client. Images are built with v1.2.3 or
# validation-<short sha> (plan D11); locally it stays `dev`.
APP_VERSION=dev

# Comma-separated origins allowed by CORS. In DEV the web client is served by
# `flutter run` on its own port, so it is cross-origin: this must match the
# fixed `--web-port 5500` that dev.ps1 uses. VAL and PROD serve the client
# from the API's own origin.
FRONTEND_ORIGIN=http://localhost:5500

# Uploaded files (plan D18). Relative to server/, where dev.ps1 starts the API;
# `media/` is gitignored.
MEDIA_DIR=media

# ── Tests (dev.ps1 -Test) ────────────────────────────────────────────────────

# `dev.ps1 -Test` runs the server tests with DATABASE_URL set to this. The
# `wishlist_test` database is created next to the dev one on first boot (see
# docker-compose.dev.yml), so tests never touch your dev data. 127.0.0.1, not
# localhost, for the same reason as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://wishlist:wishlist@127.0.0.1:5432/wishlist_test
