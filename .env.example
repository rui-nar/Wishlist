# Wishlist — local DEV environment variables.
#
# Copy this file to `.env` (gitignored, never committed) and adjust if needed;
# the defaults below work as they are on the dev machine. `dev.ps1` loads it
# into the environment before starting anything, and docker-compose.dev.yml
# passes it to the Postgres container with `env_file:`.
#
# The server reads its settings from environment variables only (plan D10):
# server/app/settings.py never reads this file itself. VAL and PROD have their
# own .env on the VPS, with their own values.

# ── Postgres container (docker-compose.dev.yml) ──────────────────────────────

# Used by the official Postgres image on FIRST BOOT only, when the volume is
# empty: it creates this user (a superuser, so it may CREATE DATABASE, which
# the migration test needs) and this database. Changing them later does not
# alter an existing volume: run `.\dev.ps1 -Reset` to start over.
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=wishlist
POSTGRES_DB=wishlist

# ── Server settings (server/app/settings.py) ─────────────────────────────────

# SQLAlchemy URL with the psycopg 3 driver. Must match the POSTGRES_* values
# above. Postgres is published on 127.0.0.1:5432 only, so the host is
# 127.0.0.1, not localhost: Windows resolves localhost to ::1 first, and every
# connection would wait for the 5 s connect timeout before falling back.
DATABASE_URL=postgresql+psycopg://wishlist:wishlist@127.0.0.1:5432/wishlist

# dev, validation or production.
APP_ENV=dev

# Shown by /api/version and the client. Images are built with v1.2.3 or
# validation-<short sha> (plan D11); locally it stays `dev`.
APP_VERSION=dev

# Comma-separated origins allowed by CORS. In DEV the web client is served by
# `flutter run` on its own port, so it is cross-origin: this must match the
# fixed `--web-port 5500` that dev.ps1 uses. VAL and PROD serve the client
# from the API's own origin.
FRONTEND_ORIGIN=http://localhost:5500

# Uploaded files (plan D18). Relative to server/, where dev.ps1 starts the API;
# `media/` is gitignored.
MEDIA_DIR=media

# Google OAuth client IDs whose sign-in tokens the server accepts, comma-
# separated (accounts plan D2). The first is the web client's: /api/config
# hands it to the client, and Android uses it as its server client ID. A client
# ID is public, not a secret: it is in every page that shows the Google button.
# It comes from the Google Cloud console (docs/DEVELOPMENT.md, "Google sign-in
# in DEV"). Empty: sign-in answers "Google sign-in is not configured".
GOOGLE_CLIENT_IDS=

# Comma-separated Apple client IDs whose identity tokens sign-in accepts: the
# Services ID first (/api/config hands it to the web and Android), then any iOS
# bundle ID. Apple does not accept localhost, so DEV leaves it empty
# (docs/DEVELOPMENT.md). Empty: Apple sign-in is not configured.
APPLE_CLIENT_IDS=

# The Android applicationId Apple's callback hands the sign-in back to. Empty:
# Apple sign-in does not work on Android.
APPLE_ANDROID_PACKAGE=

# Revoking an account's Apple token when it is deleted, as Apple requires (iOS
# app plan D5): the team ID, and the ID and content of a Sign in with Apple key
# (the .p8 file, on one line with each line break written \n). The key is a
# secret. Any of the three empty: revocation is off, logged at start when
# APPLE_CLIENT_IDS is set. DEV leaves them empty.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Selling Premium on iPhone, through Apple (Apple IAP plan D7): the product
# id, the app's bundle id, and the In-App Purchase key's issuer ID, key ID and
# key (one line, each line break written \n; a secret). Any empty: no
# purchase is offered on iPhone and none is recorded. Outside production only
# Sandbox purchases are accepted. DEV leaves them empty.
APPLE_PRODUCT_ID=
APPLE_BUNDLE_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# Selling Premium on Android, through Google Play (Android release plan D6):
# the product id, the app's application id, the Play Developer API service
# account's JSON key (one line; a secret), and the Pub/Sub push's audience
# and service account. Any empty: no purchase is offered on Android and none
# is recorded. Outside production only test purchases are accepted. DEV
# leaves them empty.
GOOGLE_PLAY_PRODUCT_ID=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=

# Comma-separated account ids (the users table's id, never an address) of the
# admins, who see the admin panel (admin panel plan D1). Empty: no admin, and
# /api/admin answers 404 to everyone.
ADMIN_USER_IDS=

# ── Tests (dev.ps1 -Test) ────────────────────────────────────────────────────

# `dev.ps1 -Test` runs the server tests with DATABASE_URL set to this. The
# `wishlist_test` database is created next to the dev one on first boot (see
# docker-compose.dev.yml), so tests never touch your dev data. 127.0.0.1, not
# localhost, for the same reason as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://wishlist:wishlist@127.0.0.1:5432/wishlist_test
