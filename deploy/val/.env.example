# Wishlist VAL — environment for /opt/wishlist-val/docker-compose.yml.
#
# Copy to /opt/wishlist-val/.env on the VPS (mode 600, never committed) and
# replace every <placeholder>. docker-compose.yml passes it to the app and the
# database with `env_file:` (plan D10). Nothing here is shared with PROD: its
# own role, database and password (plan D2).
#
# Not set here, on purpose:
#   MEDIA_DIR    The image sets /app/media, where the media directory is
#                mounted (plan D18). A value here would override it, and
#                uploads would land in the container and vanish on the next
#                `up -d`.
#   APP_VERSION  The image is built with it (validation-<short sha>, plan
#                D11); a value here would hide the version actually running,
#                and the webhook's check for the built commit would never pass.

# ── Postgres (the db service) ────────────────────────────────────────────────

# Used by the official image on FIRST BOOT only, when the volume is empty.
# Changing them later does not alter the database. A role other than PROD's,
# so a VAL credential never opens PROD's database; seed-from-prod.sh restores
# PROD's dumps without their owners for that reason. Generate the password
# with `openssl rand -hex 32` (hex: it goes into DATABASE_URL unescaped), and
# not the same as PROD's.
POSTGRES_USER=wishlist_val
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=wishlist_val

# ── Server settings (server/app/settings.py) ─────────────────────────────────

# Same user, password and database as above; the host is the compose service.
DATABASE_URL=postgresql+psycopg://wishlist_val:<postgres-password>@db:5432/wishlist_val

APP_ENV=validation

# Comma-separated origins allowed by CORS. Empty: the web client is served by
# the app itself (same origin), and the mobile apps send no Origin.
FRONTEND_ORIGIN=

# Google OAuth client IDs whose sign-in tokens the server accepts, comma-
# separated (accounts plan D2): the web client's ID, which /api/config hands to
# the clients and Android uses as its server client ID. Public, not a secret
# (it is in every page that shows the Google button), but kept out of the
# repository with the rest of the host's values. It comes from the Google Cloud
# console (docs/DEPLOYMENT.md, step 11). Empty until then: sign-in answers
# "Google sign-in is not configured".
GOOGLE_CLIENT_IDS=

# The public origin share links are built on, `<PUBLIC_BASE_URL>/join#<token>`
# (lists plan, R1-7): scheme and host, no path, no trailing slash, e.g.
# https://<val-host>, set once Caddy serves that host (docs/DEPLOYMENT.md,
# step 6). /api/config hands it to the clients. Empty: the web client uses
# its own address, which is the same thing; the mobile apps have no address of
# their own and cannot share links. The links in emails are built on it too:
# it must be set in both VAL and PROD, and while it is empty no email is sent.
PUBLIC_BASE_URL=

# Peers whose X-Forwarded-For uvicorn trusts. Caddy's connection comes in
# through the published port, so inside the container it arrives from the
# compose network's gateway (172.x.x.1 in Docker's default pools; check with
# `docker network inspect wishlist-val_default`), not from 127.0.0.1. A list,
# never `*`, which would let a client choose the address it is logged under.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12

# ── Email notifications (comments and notifications plan D19) ────────────────

# Email is sent only when BREVO_API_KEY, EMAIL_SENDER_ADDRESS,
# NOTIFICATION_SECRET and PUBLIC_BASE_URL (above) are all set. If one is empty
# the app runs as usual and sends nothing: the emails due meanwhile are dropped,
# not sent later, and the app logs at start which variables are missing.
# Here, also only to EMAIL_ALLOWED_RECIPIENTS (below). How to turn email on:
# docs/DEPLOYMENT.md, "Release-specific steps".

# The API key of the Brevo account that sends the emails. Secret. Empty: no
# email.
BREVO_API_KEY=

# The address emails come from, a sender verified in that Brevo account (SPF
# and DKIM on its domain). Empty: no email.
EMAIL_SENDER_ADDRESS=

# The name shown next to that address. Keep it: the default applies only when
# this line is absent, and an empty value leaves emails without a sender name.
EMAIL_SENDER_NAME=Wishlist

# Signs the unsubscribe links in emails (plan D18). Secret. Generate it with
# `openssl rand -hex 32`, one for VAL and one for PROD, never shared: VAL holds
# PROD's accounts, so a shared secret would make VAL's links work on PROD.
# Changing it invalidates every unsubscribe link already sent, so never without
# a reason. Empty: no email, and unsubscribe links answer 404.
NOTIFICATION_SECRET=

# The only addresses VAL may email, comma-separated, no spaces. VAL is seeded
# from PROD, so its accounts hold real people's addresses: without this list,
# one pasted key would email them about test activity. Only people who know it
# is a test, the owner's own address first. Empty: VAL emails nobody, even with
# everything above set.
EMAIL_ALLOWED_RECIPIENTS=

# The background worker that turns activity into emails. `false` stops it:
# activity waits and nothing is sent until it is back on. Never empty: that is
# not a boolean, and the app would refuse to start.
NOTIFICATIONS_WORKER=true
