# deploy.ps1 settings: how to reach the VPS, and where VAL and PROD answer.
#
# Copy this file to deploy.env (gitignored, never committed: the repository is
# public) and fill in the blanks. deploy.ps1 reads it with the same rules as
# .env (Load-DotEnv.ps1) and stops, naming the key, if a value it needs is
# empty.
#
# This is not the server's .env. Nothing here reaches a container; each
# environment's own .env on the VPS configures the running app. The image and
# the compose directories are not settings: they are fixed by the plan (D6, D8)
# and live in deploy.ps1.

# ── SSH ───────────────────────────────────────────────────────────────────────
# Host (name or IP) that runs both environments' docker compose projects.
DEPLOY_HOST=
DEPLOY_SSH_PORT=22
# Account on that host allowed to run docker (the deploy user).
DEPLOY_USER=
# Private key for that account. A leading ~ means your home directory.
DEPLOY_SSH_KEY=~/.ssh/wishlist_vps

# ── Environments ──────────────────────────────────────────────────────────────
# Public URL of each environment, where the deploy checks /api/version and
# /api/health afterwards, e.g. https://<val-host> and https://<prod-host>.
DEPLOY_VAL_URL=
DEPLOY_PROD_URL=
